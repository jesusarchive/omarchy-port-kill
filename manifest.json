{
  "schemaVersion": 1,
  "id": "jesusarchive.port-kill",
  "name": "Port Kill",
  "version": "0.4.0",
  "author": "jesusarchive",
  "license": "MIT",
  "description": "Port Kill integration for Omarchy.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Port Kill",
    "description": "Find and kill processes using your development ports.",
    "category": "System",
    "aliases": [
      "ports",
      "port-kill",
      "kill-port",
      "port-killer"
    ],
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "refreshIntervalSec": 2,
      "monitoringMode": "always"
    },
    "schema": [
      {
        "key": "monitoringMode",
        "type": "enum",
        "label": "When to monitor",
        "options": [
          {
            "value": "terminal",
            "label": "Follow terminal"
          },
          {
            "value": "always",
            "label": "Always active"
          }
        ],
        "defaultValue": "always",
        "description": "Follow terminal monitors while a tracked Port Kill terminal is running. Always active monitors without a terminal. Quit stops either mode."
      },
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Check interval (seconds)",
        "min": 1,
        "max": 300,
        "step": 1,
        "defaultValue": 2,
        "description": "How often the bar checks for port changes."
      }
    ]
  },
  "homepage": "https://github.com/jesusarchive/omarchy-port-kill"
}
